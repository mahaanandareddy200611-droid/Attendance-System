PORT=3000
NODE_ENV=development

# Start MongoDB and Redis locally, then adjust these URLs if needed.
MONGO_URL=mongodb://127.0.0.1:27017/attendance_system
REDIS_URL=redis://127.0.0.1:6379

# Generate distinct random values; never use these labels as production secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRES_IN=1d
ATTENDANCE_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-bytes-long

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
ATTENDANCE_SESSION_MINUTES=60
QR_REFRESH_MS=3000
QR_ALLOWED_SKEW_SLOTS=1
QR_CHALLENGE_TTL_MS=8000
ATTENDANCE_MAX_GPS_ACCURACY_METERS=150
ATTENDANCE_MAX_GPS_AGE_MS=120000

# Required only when using biometric enrollment and verification.
BIOMETRIC_BASE_URL=
BIOMETRIC_API_KEY=
BIOMETRIC_COLLECTION_ID=students
BIOMETRIC_TIMEOUT_MS=5000
BIOMETRIC_MATCH_THRESHOLD=0.40

# Required only for password recovery email delivery.
MAIL_USER=
MAIL_PASSWORD=

# Optional one-time bootstrap values for `npm run admin:create`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_MOBILE=
