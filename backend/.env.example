PORT=3000
NODE_ENV=development
# Set to production only after release gates are signed off.
ATTENDANCE_RELEASE_CHANNEL=development
ATTENDANCE_REQUIRE_BIOMETRIC=false
ATTENDANCE_REQUIRE_PRIVATE_STORAGE=false
ATTENDANCE_REQUIRE_EMAIL=false

# Start MongoDB and Redis locally, then adjust these URLs if needed.
MONGO_URL=mongodb://127.0.0.1:27017/attendance_system
REDIS_URL=redis://127.0.0.1:6379

# Generate distinct random values; never use these labels as production secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRES_IN=1d
ATTENDANCE_TOKEN_SECRET=replace-with-a-different-random-secret-at-least-32-bytes-long

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081
ATTENDANCE_SESSION_MINUTES=60
QR_REFRESH_MS=3000
QR_ALLOWED_SKEW_SLOTS=1
QR_CHALLENGE_TTL_MS=8000
ATTENDANCE_MAX_GPS_ACCURACY_METERS=150
ATTENDANCE_MAX_GPS_AGE_MS=120000

# Request IP attribution: keep 0 for direct local development; use 1 behind
# a single trusted reverse proxy (Render). Never blindly trust all proxies.
TRUST_PROXY_HOPS=0
# Keep false until biometric model rights, actual active-PAD tests, device tests,
# classroom pilot and privacy review are signed off.
BIOMETRIC_PRODUCTION_APPROVED=false
SESSION_EXPIRY_SWEEP_MS=15000
IDEMPOTENCY_LEASE_SECONDS=30
DEVICE_REGISTRATION_CHALLENGE_TTL_MS=120000
BIOMETRIC_CHALLENGE_TTL_MS=30000
BIOMETRIC_ASSERTION_TTL_MS=30000
BIOMETRIC_ENROLL_IP_CAPACITY=300
BIOMETRIC_ENROLL_IP_REFILL=10
BIOMETRIC_ENROLL_USER_CAPACITY=3
BIOMETRIC_ENROLL_USER_REFILL=0.0002778
BIOMETRIC_CHALLENGE_IP_CAPACITY=600
BIOMETRIC_CHALLENGE_IP_REFILL=15
BIOMETRIC_CHALLENGE_USER_CAPACITY=6
BIOMETRIC_CHALLENGE_USER_REFILL=0.1
BIOMETRIC_VERIFY_IP_CAPACITY=600
BIOMETRIC_VERIFY_IP_REFILL=15
BIOMETRIC_VERIFY_USER_CAPACITY=6
BIOMETRIC_VERIFY_USER_REFILL=0.1
DEVICE_IP_RATE_CAPACITY=500
DEVICE_IP_RATE_REFILL=10
DEVICE_USER_RATE_CAPACITY=10
DEVICE_USER_RATE_REFILL=0.05

# Required only when using biometric enrollment and verification.
BIOMETRIC_BASE_URL=
BIOMETRIC_API_KEY=
BIOMETRIC_COLLECTION_ID=students
BIOMETRIC_TIMEOUT_MS=5000
BIOMETRIC_MATCH_THRESHOLD=0.40

# Private S3-compatible object storage (e.g. private Cloudflare R2 bucket).
# Use a dedicated key that can access only this private bucket.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_TIMEOUT_MS=10000
# Set true for Backblaze B2 to permanently remove all versions and delete markers.
OBJECT_STORAGE_PURGE_VERSIONS=false
MEDIA_RETENTION_DAYS=30
MEDIA_URL_TTL_SECONDS=60
ATTENDANCE_EVIDENCE_RETENTION_DAYS=7
# Retained attendance evidence reuses OBJECT_STORAGE_* settings above.
# Required only for password recovery email delivery.
MAIL_USER=
MAIL_PASSWORD=
# Optional SMTP endpoint; when MAIL_HOST is set, MAIL_PORT is required.
MAIL_HOST=
MAIL_PORT=
# true for implicit TLS (typically 465); false for STARTTLS (typically 587).
MAIL_SECURE=

# Optional one-time bootstrap values for `npm run admin:create`.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_MOBILE=

# Demo-grade active multi-frame liveness challenge (frames: center, then randomized left/right turns).
ACTIVE_LIVENESS_CENTER_MAX_OFFSET=0.10
ACTIVE_LIVENESS_TURN_MIN_OFFSET=0.14
